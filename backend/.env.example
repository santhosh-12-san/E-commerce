# Database Connection (PostgreSQL or SQLite)
# For local PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db
# For Docker PostgreSQL: postgresql+psycopg2://postgres:postgres@postgres:5432/ecommerce_db
# For SQLite: sqlite:///./ecommerce.db
DATABASE_URL=sqlite:///./ecommerce.db

# JWT Secret Key
JWT_SECRET_KEY=mini_ecommerce_super_secret_jwt_key_2026_xyz

# Default Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
